#!/bin/bash

# ip2ban.sh
# Scans Apache access logs, detects abusive IPs, adds bans to .htaccess
# inside the ip2ban block, and prunes bans older than RETENTION_DAYS.

###########################################################################
# Configuration
###########################################################################

THRESHOLD_4XX_5XX=30
THRESHOLD_KEYWORDS=5
THRESHOLD_DOS=10000
LOOKBACK_MINUTES=60
RETENTION_DAYS=30

PATH_TO_SELF="$(cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P)"

# Load keywords
IFS=$'\n' read -d '' -r -a KEYWORDS < "${PATH_TO_SELF}/keywords.txt" || true

###########################################################################
# Validate args
###########################################################################

if [[ -z "${1:-}" || -z "${2:-}" ]]; then
    echo -e "Usage:\n$0 /path/to/.htaccess \"log1 log2 log3\""
    exit 1
fi

HTACCESS="$1"
IFS=' ' read -r -a LOGS <<< "$2"

if [ ! -f "$HTACCESS" ]; then
    echo "Error: $HTACCESS does not exist."
    exit 1
fi

###########################################################################
# Preserve ownership and permissions
###########################################################################

ORIG_MODE=$(stat -c '%a' "$HTACCESS")
ORIG_OWNER=$(stat -c '%u:%g' "$HTACCESS")

###########################################################################
# Helper: CIDR subnet matcher
###########################################################################

function in_subnet {
    local ip ip_a mask netmask sub sub_ip rval start end
    local readonly BITMASK=0xFFFFFFFF

    [[ "${DEBUG:-}" == "" ]] && DEBUG=0

    IFS=/ read sub mask <<< "$1"
    IFS=. read -a sub_ip <<< "$sub"
    IFS=. read -a ip_a <<< "$2"

    [[ -z "$mask" ]] && mask=32

    netmask=$(($BITMASK<<$((32-mask)) & $BITMASK))

    start=0
    for o in "${sub_ip[@]}"; do start=$((start<<8 | o)); done
    start=$(( start & netmask ))
    end=$(( start | ~netmask & BITMASK ))

    ip=0
    for o in "${ip_a[@]}"; do ip=$((ip<<8 | o)); done

    (( ip >= start && ip <= end )) && rval=1 || rval=0

    echo "$rval"
}

###########################################################################
# Prune old bans in the ip2ban-bans block
###########################################################################

prune_old_bans() {
    local now_ts cutoff_ts
    now_ts=$(date +%s)
    cutoff_ts=$((now_ts - RETENTION_DAYS*86400))

    local tmp_bans tmp_filtered tmp_ht
    tmp_bans=$(mktemp)
    tmp_filtered=$(mktemp)
    tmp_ht=$(mktemp)

    # Extract block
    awk '/BEGIN ip2ban-bans/{f=1;next} /END ip2ban-bans/{f=0} f' "$HTACCESS" > "$tmp_bans"

    # Iterate over ban entries
    while IFS= read -r line; do
        if [[ "$line" =~ ^#\ ([0-9]{4}-[0-9]{2}-[0-9]{2})\ ([0-9]{2}:[0-9]{2}:[0-9]{2}) ]]; then
            dt="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
            ts=$(date -d "$dt" +%s 2>/dev/null || echo 0)
            IFS= read -r denyline || denyline=""

            if (( ts >= cutoff_ts )); then
                echo "$line" >> "$tmp_filtered"
                [ -n "$denyline" ] && echo "$denyline" >> "$tmp_filtered"
            fi
        else
            echo "$line" >> "$tmp_filtered"
        fi
    done < "$tmp_bans"

    # Rebuild file with pruned block
    awk -v bans_file="$tmp_filtered" '
        /BEGIN ip2ban-bans/ {
            print
            while ((getline l < bans_file) > 0) print l
            inblock=1
            next
        }
        /END ip2ban-bans/ {
            print
            inblock=0
            next
        }
        { if (!inblock) print }
    ' "$HTACCESS" > "$tmp_ht" && mv "$tmp_ht" "$HTACCESS"

    # Restore perms
    chown "$ORIG_OWNER" "$HTACCESS" 2>/dev/null || true
    chmod "$ORIG_MODE" "$HTACCESS" 2>/dev/null || true

    rm -f "$tmp_bans" "$tmp_filtered"
}

###########################################################################
# Build BANLIST from logs
###########################################################################

BANLIST=""

for server_log in "${LOGS[@]}"; do
    [ ! -f "$server_log" ] && continue

    # 1) 4xx/5xx errors
    NEWITEMS=$(awk -v datestring="$(date -d "now -${LOOKBACK_MINUTES} minutes" +[%d/%b/%Y:%H:%M:%S)" \
                    '{if ($4 > datestring && ($9 ~ /^4/ || $9 ~ /^5/)) print $1, $9}' \
                    "$server_log" \
               | sort | uniq -c | sort -nr \
               | awk -v t="$THRESHOLD_4XX_5XX" -v m="$LOOKBACK_MINUTES" '{ if ($1 > t) print $2 "|" $3" HTTP errors: "$1" in last "m" minutes" }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'

    # 2) Suspicious URLs
    NEWITEMS=$(awk -v datestring="$(date -d "now -${LOOKBACK_MINUTES} minutes" +[%d/%b/%Y:%H:%M:%S)" \
                    '{if ($4 > datestring) print $0}' "$server_log" \
               | awk -v keywords="${KEYWORDS[*]}" \
                     '{split(keywords,kw," "); for (x in kw) if ($7 ~ kw[x]) print $1, kw[x]}' \
               | sort | uniq -c | sort -nr \
               | awk -v t="$THRESHOLD_KEYWORDS" -v m="$LOOKBACK_MINUTES" '{ if ($1 > t) print $2"|Keyword "$3" seen "$1" times in last "m" minutes" }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'

    # 3) DoS behavior
    NEWITEMS=$(awk -v datestring="$(date -d "now -${LOOKBACK_MINUTES} minutes" +[%d/%b/%Y:%H:%M:%S)" \
                    '{if ($4 > datestring) print $1}' "$server_log" \
               | sort | uniq -c | sort -nr \
               | awk -v t="$THRESHOLD_DOS" -v m="$LOOKBACK_MINUTES" '{ if ($1 > t) print $2"|DoS: "$1" req in last "m" minutes" }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'
done

###########################################################################
# Read whitelist (CIDR ranges)
###########################################################################

WHITELIST=$(awk '/BEGIN ip2ban-whitelist/{f=1;next} /END ip2ban-whitelist/{f=0} f' "$HTACCESS" \
             | sed 's/^# *//' | awk '{print $1}')

###########################################################################
# First prune old bans
###########################################################################

prune_old_bans

###########################################################################
# Add new bans inside ip2ban-bans block
###########################################################################

if [ -n "$BANLIST" ]; then
    while IFS="|" read -r ip comment; do
        [ -z "$ip" ] && continue

        # Check whitelist
        WHITED=0
        for subnet in $WHITELIST; do
            if [[ $(in_subnet "$subnet" "$ip") -eq 1 ]]; then
                WHITED=1
                break
            fi
        done
        [ $WHITED -eq 1 ] && continue

        # Skip if already banned
        if awk '/BEGIN ip2ban-bans/{f=1;next} /END ip2ban-bans/{f=0} f' "$HTACCESS" | grep -Fq "Deny from $ip"; then
            continue
        fi

        # Build ban entry
        IPHOSTNAME=$(nslookup "$ip" 2>/dev/null | awk '/name / {gsub(/.$/,""); print " ["$NF"]"; exit}')
        BAN_COMMENT="# $(date +'%Y-%m-%d %H:%M:%S')${IPHOSTNAME} - $comment"
        BAN_RULE="Deny from $ip"

        tmpfile=$(mktemp)
        awk -v ban_comment="$BAN_COMMENT" -v ban_rule="$BAN_RULE" '
            /BEGIN ip2ban-bans/ {
                print
                print ban_comment
                print ban_rule
                next
            }
            { print }
        ' "$HTACCESS" > "$tmpfile" && mv "$tmpfile" "$HTACCESS"

        # Restore perms
        chown "$ORIG_OWNER" "$HTACCESS" 2>/dev/null || true
        chmod "$ORIG_MODE" "$HTACCESS" 2>/dev/null || true

        echo "Added: $ip $IPHOSTNAME - $comment"

    done <<< "$BANLIST"
fi

exit 0
