#!/bin/bash

# ip2ban.sh
# Scans Apache access logs, detects abusive IPs, adds bans to .htaccess
# inside the ip2ban block, and prunes bans older than RETENTION_DAYS.

###########################################################################
# Configuration
###########################################################################

THRESHOLD_4XX_5XX=30
THRESHOLD_KEYWORDS=5
THRESHOLD_DOS=10000
LOOKBACK_MINUTES=60
RETENTION_DAYS=45
LOG_EXTRACT_LINES=20

PATH_TO_SELF="$(cd -- "$(dirname "$0")" >/dev/null 2>&1 ; pwd -P)"

# Load keywords
IFS=$'\n' read -d '' -r -a KEYWORDS < "${PATH_TO_SELF}/ip2ban-keywords.txt" || true

###########################################################################
# Apache log timestamp filtering
###########################################################################

APACHE_DATE_AWK='
function timestamp(s, a, months, m) {
    split("Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec", months, " ")
    split(s, a, /[\/:\[]/)

    for (m = 1; m <= 12; m++)
        if (a[3] == months[m])
            break

    if (m > 12) return 0

    return sprintf("%04d%02d%02d%02d%02d%02d",
               a[4], m, a[2], a[5], a[6], a[7]) + 0
}
'
CUTOFF_DATE=$(date -d "${LOOKBACK_MINUTES} minutes ago" +%Y%m%d%H%M%S)

###########################################################################
# Validate args
###########################################################################

if [[ -z "${1:-}" || -z "${2:-}" ]]; then
    echo -e "Usage:\n$0 /path/to/.htaccess \"log1 log2 log3\""
    exit 1
fi

HTACCESS="$1"
IFS=' ' read -r -a LOGS <<< "$2"

if [ ! -f "$HTACCESS" ]; then
    echo "Error: $HTACCESS does not exist."
    exit 1
fi

###########################################################################
# Preserve ownership and permissions
###########################################################################

ORIG_MODE=$(stat -c '%a' "$HTACCESS")
ORIG_OWNER=$(stat -c '%u:%g' "$HTACCESS")

###########################################################################
# Helper: CIDR subnet matcher
###########################################################################

function in_subnet {
    python3 - "$1" "$2" <<'PY'
import ipaddress
import sys

try:
    subnet = ipaddress.ip_network(sys.argv[1], strict=False)
    ip = ipaddress.ip_address(sys.argv[2])
    print(1 if ip in subnet else 0)
except ValueError:
    print(0)
PY
}

###########################################################################
# Helper: print access log extract (method + URL only)
###########################################################################

print_log_extract() {
    local ip="$1"
    local logfile="$2"

    echo "---- Access log extract for $ip ($logfile) ----"

    awk -v ip="$ip" \
        -v cutoff="$CUTOFF_DATE" \
        "$APACHE_DATE_AWK"'
        $1 == ip && timestamp($4) > cutoff {
            gsub(/"/, "", $6)
            print $6, $7
        }' "$logfile" | tail -n "$LOG_EXTRACT_LINES"

    echo "---- End extract ----"
    echo
}

###########################################################################
# Prune old bans in the ip2ban-bans block
###########################################################################

prune_old_bans() {
    local now_ts cutoff_ts
    now_ts=$(date +%s)
    cutoff_ts=$((now_ts - RETENTION_DAYS*86400))

    local tmp_bans tmp_filtered tmp_ht
    tmp_bans=$(mktemp)
    tmp_filtered=$(mktemp)
    tmp_ht=$(mktemp)

    awk '/BEGIN ip2ban-bans/{f=1;next} /END ip2ban-bans/{f=0} f' "$HTACCESS" > "$tmp_bans"

    while IFS= read -r line; do
        if [[ "$line" =~ ^#\ ([0-9]{4}-[0-9]{2}-[0-9]{2})\ ([0-9]{2}:[0-9]{2}:[0-9]{2}) ]]; then
            dt="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
            ts=$(date -d "$dt" +%s 2>/dev/null || echo 0)
            IFS= read -r denyline || denyline=""

            if (( ts >= cutoff_ts )); then
                echo "$line" >> "$tmp_filtered"
                [ -n "$denyline" ] && echo "$denyline" >> "$tmp_filtered"
            fi
        else
            echo "$line" >> "$tmp_filtered"
        fi
    done < "$tmp_bans"

    awk -v bans_file="$tmp_filtered" '
        /BEGIN ip2ban-bans/ {
            print
            while ((getline l < bans_file) > 0) print l
            inblock=1
            next
        }
        /END ip2ban-bans/ {
            print
            inblock=0
            next
        }
        { if (!inblock) print }
    ' "$HTACCESS" > "$tmp_ht" && mv "$tmp_ht" "$HTACCESS"

    chown "$ORIG_OWNER" "$HTACCESS" 2>/dev/null || true
    chmod "$ORIG_MODE" "$HTACCESS" 2>/dev/null || true

    rm -f "$tmp_bans" "$tmp_filtered"
}

###########################################################################
# Build BANLIST from logs
###########################################################################

BANLIST=""

for server_log in "${LOGS[@]}"; do
    [ ! -f "$server_log" ] && continue

    #######################################################################
    # 1) 4xx / 5xx errors (include status code)
    #######################################################################

    NEWITEMS=$(awk -v cutoff="$CUTOFF_DATE" \
        "$APACHE_DATE_AWK"'
        timestamp($4) > cutoff && ($9 ~ /^4/ || $9 ~ /^5/) {
            print $1, $9
        }' "$server_log" \
        | sort | uniq -c | sort -nr \
        | awk -v t="$THRESHOLD_4XX_5XX" \
            -v m="$LOOKBACK_MINUTES" \
            -v logfile="$server_log" '
            $1 > t {
                print $2"|HTTP "$3" errors: "$1" in the last "m" minutes|"logfile
            }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'

    #######################################################################
    # 2) Suspicious URLs / keywords
    #######################################################################

    NEWITEMS=$(awk -v cutoff="$CUTOFF_DATE" \
        "$APACHE_DATE_AWK"'
        timestamp($4) > cutoff {
            print $0
        }' "$server_log" \
        | awk -v keywords="${KEYWORDS[*]}" \
            '{
                n = split(keywords, kw, " ")
                for (x = 1; x <= n; x++)
                    if (kw[x] != "" && $7 ~ kw[x]) {
                        print $1
                        break
                    }
            }' \
        | sort | uniq -c | sort -nr \
        | awk -v t="$THRESHOLD_KEYWORDS" \
            -v m="$LOOKBACK_MINUTES" \
            -v logfile="$server_log" '
            $1 > t {
                print $2"|Keyword abuse: "$1" hits in the last "m" minutes|"logfile
            }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'

    #######################################################################
    # 3) DoS behavior
    #######################################################################

    NEWITEMS=$(awk -v cutoff="$CUTOFF_DATE" \
        "$APACHE_DATE_AWK"'
        timestamp($4) > cutoff {
            print $1
        }' "$server_log" \
        | sort | uniq -c | sort -nr \
        | awk -v t="$THRESHOLD_DOS" \
            -v m="$LOOKBACK_MINUTES" \
            -v logfile="$server_log" '
            $1 > t {
                print $2"|DoS: "$1" req in the last "m" minutes|"logfile
            }')

    [ -n "$NEWITEMS" ] && BANLIST+="$NEWITEMS"$'\n'
done

###########################################################################
# Read whitelist (CIDR ranges)
###########################################################################

WHITELIST=$(awk '/BEGIN ip2ban-whitelist/{f=1;next} /END ip2ban-whitelist/{f=0} f' "$HTACCESS" \
    | sed 's/^# *//' | awk '{print $1}')

###########################################################################
# First prune old bans
###########################################################################

prune_old_bans

###########################################################################
# Add new bans inside ip2ban-bans block
###########################################################################

if [ -n "$BANLIST" ]; then
    while IFS="|" read -r ip comment source_log; do
        [ -z "$ip" ] && continue

        WHITED=0
        for subnet in $WHITELIST; do
            if [[ $(in_subnet "$subnet" "$ip") -eq 1 ]]; then
                WHITED=1
                break
            fi
        done
        [ $WHITED -eq 1 ] && continue

        if awk '/BEGIN ip2ban-bans/{f=1;next} /END ip2ban-bans/{f=0} f' "$HTACCESS" \
            | grep -Fq "Deny from $ip"; then
            continue
        fi

        IPHOSTNAME=$(nslookup "$ip" 2>/dev/null | awk '/name / {gsub(/.$/,""); print " ["$NF"]"; exit}')
        BAN_COMMENT="# $(date +'%Y-%m-%d %H:%M:%S')${IPHOSTNAME} - $comment"
        BAN_RULE="Deny from $ip"

        tmpfile=$(mktemp)
        awk -v ban_comment="$BAN_COMMENT" -v ban_rule="$BAN_RULE" '
            /BEGIN ip2ban-bans/ {
                print
                print ban_comment
                print ban_rule
                next
            }
            { print }
        ' "$HTACCESS" > "$tmpfile" && mv "$tmpfile" "$HTACCESS"

        chown "$ORIG_OWNER" "$HTACCESS" 2>/dev/null || true
        chmod "$ORIG_MODE" "$HTACCESS" 2>/dev/null || true

        echo "Added: $ip $IPHOSTNAME - $comment"

        if [ -n "$source_log" ] && [ -f "$source_log" ]; then
            print_log_extract "$ip" "$source_log"
        fi

    done <<< "$BANLIST"
fi

exit 0
